---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = 'DevTeam - Inscripciones',
  description = 'Formulario de inscripción para unirte a DevTeam y formar parte de la comunidad de desarrollo.',
  image = '/icon.png',
  type = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.request.url);
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);
const twitterCard = ogImage ? 'summary_large_image' : 'summary';

import Analytics from "@vercel/analytics/astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#7f56ff" />
    <meta name="author" content="DevTeam" />

    <link rel="canonical" href={pageUrl} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; filter-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="DevTeam" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={description} />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={description} />
    <slot name="head" />

    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Open Sauce Two";
    src: url("../assets/fonts/sans/OpenSauceSans-Regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Open Sauce Two";
    src: url("../assets/fonts/sans/OpenSauceSans-Medium.ttf") format("truetype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Open Sauce Two";
    src: url("../assets/fonts/sans/OpenSauceSans-SemiBold.ttf") format("truetype");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Open Sauce Two";
    src: url("../assets/fonts/sans/OpenSauceSans-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Open Sauce Two";
    src: url("../assets/fonts/sans/OpenSauceSans-ExtraBold.ttf") format("truetype");
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Open Sauce Two";
    src: url("../assets/fonts/sans/OpenSauceSans-Black.ttf") format("truetype");
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Brand Primary: Purple */
    --color-purple: #7f56ff;
    --color-purple-hover: #6941c6;
    --color-purple-light: rgba(127, 86, 255, 0.1);
    --color-purple-focus: rgba(127, 86, 255, 0.3);

    /* Brand Secondary/Accent: Lime Green */
    --color-lime: #cdff95;
    --color-lime-hover: #bcf77e;
    --color-lime-dark: #27400b; /* Contraste oscuro para texto en fondo lime */
    --color-lime-light: rgba(205, 255, 149, 0.15);
    --color-lime-focus: rgba(205, 255, 149, 0.4);

    /* Brand Success (basado en la paleta lime) */
    --color-success-bg: #f7ffe6;
    --color-success-border: #bcf77e;
    --color-success-text: #223c05;

    /* Estados de Error y Alertas */
    --color-error-bg: #fef2f2;
    --color-error-border: #fecaca;
    --color-error-text: #991b1b;
    --color-error-focus: rgba(220, 38, 38, 0.15);

    /* Neutros Premium */
    --color-text-main: #111827;
    --color-text-secondary: #4b5563;
    --color-text-muted: #6b7280;
    --color-border: #d1d5db;
    --color-bg-main: #f9fafb;
    --color-white: #ffffff;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    font-family: "Open Sauce Two", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.5;
    letter-spacing: -0.02rem;
    color: var(--color-text-main);
    background: var(--color-bg-main);
    height: 100vh;
    background-color: #ffffff;
    background-image: 
      linear-gradient(to right, #d9d9d936 1px, transparent 1px),
      linear-gradient(to bottom, #d9d9d936 1px, transparent 1px);
    background-size: 6rem 4rem;    
    /* background-image: 
      linear-gradient(to right, #8080800a 1px, transparent 1px),
      linear-gradient(to bottom, #8080800a 1px, transparent 1px);
    background-size: 14px 24px; */
    letter-spacing: -0.02rem !important;
  }

  :focus-visible {
    outline: 2px solid var(--color-purple);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
