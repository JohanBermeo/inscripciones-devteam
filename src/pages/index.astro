---
import RegistrationForm from '../components/forms/RegistrationForm.astro';
import Layout from '../layouts/Layout.astro';
import { generateCsrfToken } from '../lib/security/csrf';

const locals = Astro.locals as { formOpen: boolean };
const formOpen = locals.formOpen ?? true;

const csrfToken = await generateCsrfToken();

Astro.cookies.set('csrf_token', csrfToken, {
  httpOnly: true,
  secure: import.meta.env.PROD,
  sameSite: 'strict',
  maxAge: 3600,
  path: '/',
});
---

<Layout title="Inscripción - DevTeam">
  <div class="container" >
    <div class="page-header">
      <div class="header">
        <div class="leftContainer">
          <div class="header-title">
            <span class="status-badge">Inscripciones Abiertas<span class="status-badge-dot"></span></span>
            <h1>Formulario de Inscripción</h1>
          </div>
          <p class="subtitle">DevTeam - Proyección Social</p>
        </div>
        <img src="/icon.png" alt="Logo de DevTeam" class="header-logo" />
      </div>
    </div>

    <div class="page-container">
      <div class="page-inner">
        {formOpen ? (
          <RegistrationForm csrfToken={csrfToken} deadline="2025-08-08T23:59:59-05:00" />
        ) : (
          <section class="closed-message" role="alert">
            <h2>Inscripciones Cerradas</h2>
            <p>El período de inscripciones finalizó el <strong>8 de agosto de 2025</strong>.</p>
            <p>Gracias por tu interés en formar parte del DevTeam.</p>
          </section>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    height: 100%;
  }
  
  .page-container {
    position: relative;
    top: 100px;
  }
  
  .header {
    text-align: left;
    padding: 20px 32px;
    position: fixed;
    display: flex;
    width: 100%;
    background: rgba(255, 255, 255, 0.34);
    border-radius: 0px 0px 32px 32px;
    z-index: 1000000;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ddd;
    backdrop-filter: blur(14.9px);
  }

  .header-title {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  h1 {
    font-family: "Open Sauce Two", sans-serif;
    font-size: 24px;
    font-weight: 800;
    margin: 0px;
    color: var(--color-text-main);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-lime);
    color: var(--color-lime-dark);
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-style: italic;
    width: fit-content;  
  }

  .status-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-lime-dark);
    animation: pulse-dot 1.8s ease infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.75); }
  }

  .subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    font-weight: 500;
    margin: 0 0 0.5rem;
  }

  .page-inner {
    margin: 0 auto;
    padding: 5rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .closed-message {
    text-align: center;
    padding: 3rem 1rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error-border);
    border-radius: 0.75rem;
    color: var(--color-error-text);
  }

  .closed-message h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .closed-message p {
    margin: 0.25rem 0;
    font-size: 1rem;
  }

  .header-logo {
    height: 100px;
    width: 100px;
    object-fit: contain;
  }

  /* ── Tablet (≤ 768px) ─────────────────────────────── */
  @media (max-width: 768px) {
    .header {
      padding: 1.25rem 1.5rem 0.75rem;
    }

    h1 {
      font-size: 28px;
    }

    .subtitle {
      font-size: 17px;
    }

    .info-text {
      font-size: 14px;
    }

    .page-inner {
      padding: 2.5rem 1.5rem;
    }

    .page-container {
      position: static;
    }

    .header {
      top: 0px;
      position: sticky; 
    }

    .container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100vh;
    }

    .page-header {
      position: absolute;
      top: 0;
      width: 100%;
    }
  }

  /* ── Mobile (≤ 480px) ─────────────────────────────── */
  @media (max-width: 480px) {
    .header {
      padding: 16px 20px;
    }

    h1 {
      font-size: 18px;
    }

    .subtitle {
      font-size: 15px;
    }

    .info-text {
      font-size: 13px;
    }

    .page-inner {
      padding: 24px 24px;
    }

    .closed-message {
      padding: 2rem 0.75rem;
    }

    .header-logo {
      height: 68px;
      width: 68px;
    }
  }
</style>
